  "complexity_assessment": {
    "tradeoff": "The clipping index/cache and parallel geometry staging add real complexity. File organization makes their responsibilities and lifetimes easier to inspect; it does not remove that maintenance cost.",
    "boundaries": [
      "Exact clipping and its conservative index live under LocalZ",
      "Mixed-filament channel resolution and sequential activation tracking live under MixedFilament",
      "Shared batching, outline reuse and developer instrumentation live under Slicing"
    ],
    "lifetime": "Clipping caches belong to an export layer; outline caches belong to a source-layer preparation task. Borrowed geometry must remain immutable for the documented lifetime.",
    "geometry_admission": "At most 64 layers and 131072 input points per batch, with one neighboring layer on each side. An oversized single layer is admitted to guarantee progress; this is not a hard cap on Boolean output memory.",
    "clipping_cache_budget": "32 MiB accounted entry storage and 65536 entries per layer, excluding allocator and index/mask bookkeeping overhead.",
    "scope": "All selected performance mechanisms retained; existing cadence, ratio and tool-scheduling policy stay sequential."
  },
  "ported_features": [
    "Opt-in Local-Z SVG/JSON and expensive leak diagnostics",
    "Borrowed extrusion traversal, wall outlines, graph input and synchronous G-code buffers",
    "Mixed-component tracking early-outs, one-time region bounds and reusable surface buckets",
    "Compact graph candidates, selector reuse and compact strict painted meshes",
    "Parallel painted occlusion and bounded outline reuse using current shell gathering",
    "Bounded parallel Local-Z geometry with immutable mixed-row snapshots and serial cadence",
    "Conservative empty-path index, exact Clipper results and bounded repeated-mask cache",
    "Parallel wipe-pass eligibility with sequential tool scheduling"
  ],
